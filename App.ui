  <property name="styleSheet">
   <string notr="true">/* ---------- base ---------- */
QMainWindow, QDialog, QMessageBox { background: #07150f; }
QWidget#root {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #06140f, stop:1 #0f2f20);
}
QWidget { color: #f3efe0; font-family: &quot;Segoe UI&quot;, Arial; font-size: 10pt; }
QLabel { background: transparent; text-decoration: none; font-style: normal; }

/* ---------- header ---------- */
QFrame#header {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #14532d, stop:1 #0b2e1c);
    border: 1px solid #f2c14e; border-radius: 16px;
}
QFrame#header_inner { background: transparent; border: none; }
QLabel#title { font-size: 22pt; font-weight: 700; color: #f2c14e; }
QLabel#subtitle { color: #cfe3d6; }
QLabel#stat_Total, QLabel#Stat_Shown, QLabel#stat_total, QLabel#stat_shown {
    background: rgba(242, 193, 78, 0.18); color: #f2c14e; border-radius: 10px;
    padding: 0px; font-size: 11pt; font-weight: 700; qproperty-alignment: AlignCenter;
}

/* ---------- tabs ---------- */
QTabWidget::pane {
    background: #0c241a; border: 1px solid #1f4a35; border-radius: 14px; top: 4px;
}
QWidget#tab, QWidget#tab_2 { background: transparent; }
QTabBar::tab {
    background: #12301f; color: #8fb09c; padding: 8px 26px; margin-right: 6px;
    border-top-left-radius: 12px; border-top-right-radius: 12px; font-weight: 600;
}
QTabBar::tab:hover { color: #f3efe0; }
QTabBar::tab:selected { background: #1d5233; color: #f2c14e; }

/* ---------- cards ---------- */
QGroupBox {
    background: rgba(15, 42, 30, 0.85); border: 1px solid #1f4a35; border-radius: 14px;
    margin-top: 14px; padding: 0px; font-weight: 600;
}
QGroupBox::title { subcontrol-origin: margin; left: 16px; padding: 0 8px; color: #f2c14e; }

/* ---------- inputs ---------- */
QLineEdit, QComboBox, QSpinBox, QPlainTextEdit {
    background: #08190f; border: 1px solid #2a6a47; border-radius: 8px; padding: 2px 8px;
    selection-background-color: #f2c14e; selection-color: #07150f;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border: 1px solid #f2c14e; }
QComboBox::drop-down { border: none; width: 22px; }
QComboBox QAbstractItemView {
    background: #0f2a1e; border: 1px solid #2a6a47;
    selection-background-color: #f2c14e; selection-color: #07150f; outline: none;
}

/* ---------- buttons ---------- */
QPushButton {
    background: #1d5233; border: none; border-radius: 8px; padding: 0px 6px;
    font-size: 9pt; font-weight: 600; color: #f3efe0;
}
QPushButton:hover { background: #26704a; }
QPushButton:pressed { background: #14402a; }
QPushButton:disabled { background: #0f2a1e; color: #4f7561; }

QPushButton#btn_sort, QPushButton#btn_search, QPushButton#btn_start, QPushButton#btn_edit_row
    { background: #f2c14e; color: #07150f; }
QPushButton#btn_sort:hover, QPushButton#btn_search:hover, QPushButton#btn_start:hover,
QPushButton#btn_edit_row:hover { background: #ffd978; }

QPushButton#btn_bench, QPushButton#btn_resume, QPushButton#btn_add_row
    { background: #2ecc71; color: #07150f; }
QPushButton#btn_bench:hover, QPushButton#btn_resume:hover, QPushButton#btn_add_row:hover
    { background: #52e08f; }

QPushButton#btn_stop, QPushButton#btn_delete_row { background: #c0392b; color: white; }
QPushButton#btn_stop:hover, QPushButton#btn_delete_row:hover { background: #dc4a3b; }

QPushButton#btn_sort:disabled, QPushButton#btn_search:disabled, QPushButton#btn_start:disabled,
QPushButton#btn_bench:disabled, QPushButton#btn_resume:disabled, QPushButton#btn_stop:disabled
    { background: #0f2a1e; color: #4f7561; }

/* ---------- table ---------- */
QTableView {
    background: #08190f; alternate-background-color: #0f2a1e; gridline-color: #1f4a35;
    border: 1px solid #1f4a35; border-radius: 10px;
    selection-background-color: #f2c14e; selection-color: #07150f;
}
QHeaderView::section {
    background: #14532d; color: #f2c14e; padding: 6px 8px; border: none;
    border-right: 1px solid #07150f; font-weight: 700;
}
QTableCornerButton::section { background: #14532d; border: none; }

/* ---------- scrollbars ---------- */
QScrollBar:vertical { background: #07150f; width: 12px; margin: 0; }
QScrollBar::handle:vertical { background: #2a6a47; border-radius: 6px; min-height: 36px; }
QScrollBar::handle:vertical:hover { background: #f2c14e; }
QScrollBar:horizontal { background: #07150f; height: 12px; margin: 0; }
QScrollBar::handle:horizontal { background: #2a6a47; border-radius: 6px; min-width: 36px; }
QScrollBar::handle:horizontal:hover { background: #f2c14e; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }

/* ---------- progress + labels ---------- */
QProgressBar {
    background: #08190f; border: 1px solid #2a6a47; border-radius: 10px;
    text-align: center; color: white; font-weight: 600;
}
QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #2ecc71, stop:1 #f2c14e);
    border-radius: 9px;
}
QLabel#metrics, QLabel#search_info { color: #7fe0b2; font-weight: 600; }
QLabel#levels_label, QLabel#count_label, QLabel#info_label { color: #8fb09c; }
QToolTip { background: #0f2a1e; color: white; border: 1px solid #f2c14e; padding: 4px; }</string>
